{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["pnpm"],
      "ignoreBinaries": ["ffmpeg"]
    },

    "packages/mochart": {
      "entry": [
        "scripts/*.ts",
        "src/config/docs/*.ts"
      ]
    },

    "packages/mochart-docs": {
      "entry": [
        "scripts/*.ts",
        "examples/*.ts",
        "**/*.data.ts",
        "**/*.paths.ts"
      ]
    },

    "packages/mochart-demo-common": {
      "entry": ["scripts/*.ts"],
      "includeEntryExports": true
    },
    "packages/mochart-demo-basic": {
      "entry": ["e2e/*.spec.ts"],
      "includeEntryExports": true
    },
    "packages/mochart-demo-e2e": {
      "entry": ["e2e/*.spec.ts"],
      "includeEntryExports": true
    },
    "packages/mochart-demo-data": { "includeEntryExports": true },
    "packages/mochart-demo-vanilla": { "includeEntryExports": true },
    "packages/mochart-demo-react": { "includeEntryExports": true },
    "packages/mochart-demo-svelte": { "includeEntryExports": true },
    "packages/mochart-demo-vue": { "includeEntryExports": true },
    "packages/mochart-demo-lit": { "includeEntryExports": true },
    "packages/mochart-demo-angular": { "includeEntryExports": true },
    "packages/mochart-benchmark": { "includeEntryExports": true }
  },

  "ignoreExportsUsedInFile": true
}
