{
  "name": "@mochart/docs",
  "version": "1.0.0",
  "description": "Documentation site for the mochart charting library",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Jon Harris",
    "url": "https://github.com/jharris4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mocharts/mochart.git"
  },
  "type": "module",
  "scripts": {
    "gen": "tsx --conditions=development ../mochart/scripts/generator.ts && tsx --conditions=development scripts/generateBindings.ts",
    "dev": "npm run gen && vitepress dev --port 5181",
    "prebuild": "node ../../scripts/ensure-libs-fresh.mjs",
    "build": "npm run gen && vitepress build",
    "preview": "vitepress preview",
    "test": "npm run gen && tsx --conditions=development scripts/checkExamples.ts && tsx --conditions=development scripts/checkApiCoverage.ts && tsx --conditions=development scripts/checkSectionCoverage.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.vue.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@mochart/core": "*",
    "@mochart/demo-common": "*",
    "@mochart/export": "*"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitepress": "2.0.0-alpha.19",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  }
}
