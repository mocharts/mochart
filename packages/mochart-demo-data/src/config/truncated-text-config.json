{
  "version": "1.0.0",
  "chart": {
    "margin": {
      "top": 1,
      "right": 1,
      "bottom": 1,
      "left": 1
    },
    "padding": {
      "top": 3,
      "right": 3,
      "bottom": 3,
      "left": 3
    },
    "backgroundStyle": {
      "strokeColor": "#808080",
      "strokeOpacity": 1,
      "fillColor": null,
      "fillOpacity": 0,
      "strokeWidth": 1
    }
  },
  "plot": {
    "inverted": false,
    "margin": {
      "top": 2,
      "right": 2,
      "bottom": 2,
      "left": 2
    },
    "padding": {
      "top": 8,
      "right": 8,
      "bottom": 8,
      "left": 8
    },
    "backgroundStyle": {
      "strokeColor": "#808080",
      "strokeOpacity": 1,
      "fillColor": null,
      "fillOpacity": 0,
      "strokeWidth": 1
    }
  },
  "title": {
    "text": "A Title With Truncated Text That Is Really Long And Will Not Overflow The Boundaries",
    "prefix": {
      "text": "Prefix #",
      "margin": {
        "top": 0,
        "right": 5,
        "bottom": 0,
        "left": 0
      },
      "padding": {
        "top": 1,
        "right": 1,
        "bottom": 1,
        "left": 1
      },
      "backgroundStyle": {
        "strokeColor": "#808080",
        "strokeOpacity": 1,
        "fillColor": "#808080",
        "fillOpacity": 0.15,
        "strokeWidth": 1
      }
    },
    "suffix": {
      "text": "# Suffix",
      "margin": {
        "top": 0,
        "right": 0,
        "bottom": 0,
        "left": 5
      },
      "padding": {
        "top": 1,
        "right": 1,
        "bottom": 1,
        "left": 1
      },
      "backgroundStyle": {
        "strokeColor": "#808080",
        "strokeOpacity": 1,
        "fillColor": "#808080",
        "fillOpacity": 0.15,
        "strokeWidth": 1
      }
    },
    "verticalAlign": "middle",
    "margin": {
      "top": 2,
      "right": 0,
      "bottom": 7,
      "left": 0
    },
    "padding": {
      "top": 2,
      "right": 5,
      "bottom": 2,
      "left": 5
    },
    "textMargin": {
      "top": 0,
      "right": 0,
      "bottom": 0,
      "left": 0
    },
    "textPadding": {
      "top": 3,
      "right": 1,
      "bottom": 3,
      "left": 1
    },
    "backgroundStyle": {
      "strokeColor": "#808080",
      "strokeOpacity": 1,
      "fillColor": "#808080",
      "fillOpacity": 0.25,
      "strokeWidth": 1
    },
    "textBackgroundStyle": {
      "strokeColor": "#808080",
      "strokeOpacity": 1,
      "fillColor": "#808080",
      "fillOpacity": 0.1,
      "strokeWidth": 1
    },
    "truncation": {
      "enabled": true,
      "text": "..."
    }
  },
  "legend": {
    "margin": {
      "top": 7,
      "right": 0,
      "bottom": 2,
      "left": 0
    },
    "padding": {
      "top": 2,
      "right": 5,
      "bottom": 2,
      "left": 5
    },
    "item": {
      "margin": {
        "top": 2,
        "right": 2,
        "bottom": 2,
        "left": 2
      },
      "padding": {
        "top": 2,
        "right": 2,
        "bottom": 2,
        "left": 2
      },
      "backgroundStyle": {
        "strokeColor": "#808080",
        "strokeOpacity": 1,
        "fillColor": "#808080",
        "fillOpacity": 0.15,
        "strokeWidth": 1
      }
    },
    "backgroundStyle": {
      "strokeColor": "#808080",
      "strokeOpacity": 1,
      "fillColor": "#808080",
      "fillOpacity": 0.25,
      "strokeWidth": 1
    }
  },
  "animation": {
    "expansionDuration": 1000,
    "initialDuration": 1000,
    "valueChangeDuration": 1000,
    "contractionDuration": 1000
  },
  "categoryAxis": {
    "valueLabel": "Category",
    "property": "categoryDisplay",
    "keyProperty": "category",
    "type": "string",
    "scale": "ordinal",
    "tickLabel": {
      "truncation": {
        "enabled": true,
        "text": "...",
        "maxFraction": 0.2
      }
    },
    "title": {
      "text": "A Category Axis Title That Has Really Long Text That Should Not Overflow The Boundaries",
      "truncation": {
        "enabled": true,
        "text": "..."
      }
    }
  },
  "valueAxes": {
    "title": {
      "text": "A Value Axis Title That Has Really Long Text That Should Not Overflow The Boundaries",
      "truncation": {
        "enabled": true,
        "text": "..."
      }
    }
  },
  "series": [
    {
      "property": "value1",
      "title": "The first series with a descriptive title",
      "renderer": "bar"
    },
    {
      "property": "value2",
      "title": "The second series with a less descriptive title",
      "renderer": "line"
    },
    {
      "property": "value3",
      "title": "This one is Third",
      "renderer": "line",
      "allowAbsentDataProperties": true
    },
    {
      "property": "value4",
      "title": "Fourth may be the last for now",
      "renderer": "line",
      "allowAbsentDataProperties": true
    }
  ]
}
