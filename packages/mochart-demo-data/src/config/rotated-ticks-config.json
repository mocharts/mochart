{
  "version": "1.0.0",
  "title": {
    "text": "Rotated Ticks Example"
  },
  "legend": {
    "visible": true
  },
  "categoryAxis": {
    "valueLabel": "Category",
    "property": "categoryDO",
    "type": "date",
    "scale": "ordinal",
    "tickLabel": {
      "format": "%Y-%m-%d",
      "rotation": 90
    },
    "title": {
      "text": "Date Ticks Rotated 90 Degrees"
    }
  },
  "valueAxes": {
    "tickLabel": {
      "rotation": 45
    },
    "title": {
      "text": "Ticks Rotated 45 Degrees"
    }
  },
  "series": {
    "property": "value9",
    "title": "Large Number",
    "renderer": "line"
  }
}
