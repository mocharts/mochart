{
  "version": "1.0.0",
  "title": {
    "text": "Threshold Step"
  },
  "categoryAxis": {
    "property": "date",
    "type": "date",
    "scale": "ordinal",
    "tickLabel": {
      "format": "%b %d"
    },
    "valueFormat": "%a %b %d",
    "tickStep": {
      "period": "week"
    },
    "thresholdStep": {
      "visible": true,
      "period": "week",
      "count": 2,
      "range": true,
      "front": false,
      "style": {
        "normal": {
          "strokeOpacity": 0,
          "fillOpacity": 0.08
        }
      }
    }
  },
  "valueAxes": [
    {
      "id": "VA0",
      "min": 0,
      "gridLine": {
        "visible": true
      },
      "title": {
        "text": "Sessions"
      }
    },
    {
      "id": "VA1",
      "min": 0,
      "side": "end",
      "title": {
        "text": "Conversions"
      }
    }
  ],
  "series": [
    {
      "axis": "VA0",
      "property": "sessions",
      "renderer": "line",
      "title": "Sessions"
    },
    {
      "axis": "VA1",
      "property": "conversions",
      "renderer": "line",
      "title": "Conversions"
    }
  ]
}
