{
  "version": "1.0.0",
  "title": {
    "text": "Missing Pos/Neg Stacked Values"
  },
  "animation": {},
  "tooltip": {
    "showMissingValues": true,
    "missingValueText": "N/A"
  },
  "categoryAxis": {
    "title": {
      "text": "Category Axis"
    },
    "gridLine": {
      "visible": true,
      "style": {
        "normal": {
          "strokeWidth": 1,
          "strokeDashArray": "5, 5"
        }
      }
    },
    "min": "auto",
    "max": "auto",
    "type": "number",
    "scale": "ordinal",
    "valueLabel": "Category",
    "property": "category",
    "side": "end"
  },
  "valueAxes": [
    {
      "title": {
        "text": "Value Axis 1"
      },
      "axisLine": {
        "visible": true
      },
      "gridLine": {
        "visible": false
      },
      "id": "VA1",
      "base": 0,
      "softMin": 0,
      "softMax": 0,
      "side": "start"
    }
  ],
  "seriesStacks": [
    {
      "axis": "VA1",
      "id": "SS1"
    }
  ],
  "seriesDefaults": {
    "renderer": "bar",
    "axis": "VA1",
    "stack": "SS1"
  },
  "series": [
    {
      "title": "Value 0",
      "property": "value0",
      "cap": {
        "type": "round",
        "size": 10,
        "expand": true,
        "onlyStackOuter": true
      }
    },
    {
      "title": "Value 1",
      "property": "value1",
      "cap": {
        "type": "round",
        "size": 10,
        "expand": true,
        "onlyStackOuter": true
      }
    },
    {
      "title": "Value 2",
      "property": "value2",
      "cap": {
        "type": "round",
        "size": 10,
        "expand": true,
        "onlyStackOuter": true
      }
    }
  ]
}
