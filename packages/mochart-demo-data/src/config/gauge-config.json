{
  "version": "1.0.0",
  "title": {
    "text": "Customer Sentiment (fictional survey)"
  },
  "chart": {
    "type": "pie"
  },
  "pie": {
    "tooltip": {
      "valueType": "percentValue"
    },
    "startAngle": -90,
    "endAngle": 90,
    "innerRadiusFraction": 0.55,
    "padAngle": 1,
    "cornerRadius": 3,
    "label": {
      "visible": true,
      "type": "title"
    },
    "centerLabel": {
      "text": "responses"
    },
    "centerTotal": {
      "visible": true,
      "format": ",.0f"
    },
    "centerOffsetYFraction": -0.25
  },
  "categoryAxis": {
    "property": "category",
    "type": "string",
    "scale": "ordinal"
  },
  "series": [
    {
      "id": "slice0",
      "property": "slice0",
      "title": "Promoters"
    },
    {
      "id": "slice1",
      "property": "slice1",
      "title": "Passives"
    },
    {
      "id": "slice2",
      "property": "slice2",
      "title": "Detractors"
    }
  ]
}
