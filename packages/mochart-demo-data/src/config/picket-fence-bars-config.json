{
  "version": "1.0.0",
  "title": {
    "text": "Picket Fence Bars"
  },
  "animation": {
    "enabled": true,
    "expansionDuration": 1500,
    "initialDuration": 3000,
    "valueChangeDuration": 3000,
    "contractionDuration": 1500,
    "focusDuration": 800
  },
  "categoryAxis": {
    "title": {
      "text": "Month"
    },
    "axisLine": {
      "visible": true,
      "marginInner": 0
    },
    "gridLine": {
      "visible": true
    },
    "tickLabel": {
      "format": "%b",
      "rotation": 45
    },
    "tickCount": 12,
    "type": "date",
    "scale": "ordinal",
    "dateUTC": true,
    "valueLabel": "Category",
    "valueFormat": "%B",
    "property": "date",
    "side": "end"
  },
  "valueAxes": {
    "visible": true,
    "axisLine": {
      "marginInner": 0
    },
    "gridLine": {
      "visible": true
    },
    "tickLabel": {
      "format": "$s"
    },
    "title": {
      "text": "Monthly Amount"
    },
    "min": 0,
    "side": "start"
  },
  "seriesStacks": {},
  "seriesDefaults": {
    "renderer": "bar",
    "marker": {
      "shape": null
    }
  },
  "series": [
    {
      "title": "Round",
      "property": "value1",
      "cap": {
        "size": 15,
        "type": "round"
      }
    },
    {
      "title": "Curve",
      "property": "value2",
      "cap": {
        "size": 15,
        "type": "curve"
      }
    },
    {
      "title": "Point",
      "property": "value3",
      "cap": {
        "size": 15,
        "type": "point"
      }
    }
  ]
}
