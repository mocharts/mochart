{
  "version": "1.0.0",
  "title": {
    "text": "Multiple Axes"
  },
  "animation": {
    "enabled": true,
    "expansionDuration": 500,
    "initialDuration": 500,
    "valueChangeDuration": 500,
    "contractionDuration": 500,
    "focusDuration": 700
  },
  "categoryAxis": {
    "title": {
      "text": "Time (in Minutes)"
    },
    "axisLine": {
      "visible": true,
      "marginInner": 0
    },
    "tickLabel": {
      "format": "%_H:%M"
    },
    "type": "date",
    "scale": "linear",
    "dateUTC": true,
    "valueLabel": "Time",
    "property": "time",
    "side": "end"
  },
  "valueAxisDefaults": {
    "axisLine": {
      "marginInner": 0
    },
    "gridLine": {
      "visible": false
    },
    "min": 0
  },
  "valueAxes": [
    {
      "tickLabel": {
        "format": "$s"
      },
      "title": {
        "text": "Sales Value"
      },
      "id": "VA1",
      "side": "start"
    },
    {
      "tickLabel": {
        "format": "$s"
      },
      "id": "VA0",
      "side": "start"
    },
    {
      "gridLine": {
        "visible": true
      },
      "id": "VA2",
      "side": "end"
    },
    {
      "title": {
        "text": "Sold Count"
      },
      "id": "VA3",
      "side": "end"
    }
  ],
  "seriesDefaults": {
    "renderer": "line",
    "marker": {
      "shape": null
    }
  },
  "series": [
    {
      "title": "Sales A",
      "axis": "VA0",
      "property": "sales_a"
    },
    {
      "title": "Running Sales A",
      "axis": "VA1",
      "property": "running_sales_a"
    },
    {
      "title": "Sales B",
      "axis": "VA0",
      "property": "sales_b"
    },
    {
      "title": "Running Sales B",
      "axis": "VA1",
      "property": "running_sales_b"
    },
    {
      "title": "Count A",
      "axis": "VA2",
      "property": "count_a"
    },
    {
      "title": "Running Count A",
      "axis": "VA3",
      "property": "running_count_a"
    },
    {
      "title": "Count B",
      "axis": "VA2",
      "property": "count_b"
    },
    {
      "title": "Running Count B",
      "axis": "VA3",
      "property": "running_count_b"
    }
  ]
}
