{
  "version": "1.0.0",
  "title": {
    "text": "Stacked Bar & Area Example"
  },
  "categoryAxis": {
    "valueLabel": "Category",
    "property": "categoryNO",
    "type": "number",
    "scale": "ordinal"
  },
  "valueAxisDefaults": {
    "base": 0,
    "softMin": 0,
    "softMax": 0
  },
  "valueAxes": [
    {
      "id": "VA0",
      "side": "start"
    },
    {
      "id": "VA1",
      "side": "end"
    }
  ],
  "seriesStacks": [
    {
      "axis": "VA0",
      "id": "SS0"
    },
    {
      "axis": "VA1",
      "id": "SS1"
    }
  ],
  "series": [
    {
      "axis": "VA0",
      "stack": "SS0",
      "property": "value1",
      "title": "Stacked Bar 1",
      "renderer": "bar"
    },
    {
      "axis": "VA0",
      "stack": "SS0",
      "property": "value2",
      "title": "Stacked Bar 2",
      "renderer": "bar"
    },
    {
      "axis": "VA0",
      "stack": "SS0",
      "property": "value3",
      "title": "Stacked Bar 3",
      "renderer": "bar"
    },
    {
      "axis": "VA1",
      "stack": "SS1",
      "property": "value4",
      "title": "Stacked Area 1",
      "renderer": "area"
    },
    {
      "axis": "VA1",
      "stack": "SS1",
      "property": "value5",
      "title": "Stacked Area 2",
      "renderer": "area"
    },
    {
      "axis": "VA1",
      "stack": "SS1",
      "property": "value6",
      "title": "Stacked Area 3",
      "renderer": "area"
    }
  ]
}
