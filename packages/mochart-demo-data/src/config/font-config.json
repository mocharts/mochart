{
  "version": "1.0.0",
  "chart": {
    "font": {
      "family": "Georgia, serif",
      "size": 12
    }
  },
  "title": {
    "text": "Monthly Amounts in Georgia",
    "font": {
      "size": 18,
      "weight": "bold"
    }
  },
  "legend": {
    "item": {
      "font": {
        "size": "0.9em"
      }
    }
  },
  "categoryAxis": {
    "title": {
      "text": "Month",
      "font": {
        "size": "110%",
        "style": "italic"
      }
    },
    "gridLine": {
      "visible": true
    },
    "tickLabel": {
      "format": "%b",
      "font": {
        "weight": 600
      }
    },
    "type": "date",
    "scale": "ordinal",
    "dateUTC": true,
    "valueLabel": "Category",
    "valueFormat": "%B",
    "property": "date"
  },
  "valueAxes": {
    "gridLine": {
      "visible": true
    },
    "tickLabel": {
      "format": "$s",
      "font": {
        "size": 10
      }
    },
    "title": {
      "text": "Monthly Amount",
      "font": {
        "style": "italic"
      }
    },
    "min": 0
  },
  "tooltip": {
    "font": {
      "size": 11
    }
  },
  "series": [
    {
      "title": "Bars",
      "property": "value1",
      "renderer": "bar",
      "labelProperty": "value1",
      "label": {
        "format": "$.3s",
        "position": "outside",
        "font": {
          "family": "monospace",
          "size": 9,
          "weight": "bold"
        }
      }
    },
    {
      "title": "Line",
      "property": "value2",
      "renderer": "line"
    }
  ]
}
