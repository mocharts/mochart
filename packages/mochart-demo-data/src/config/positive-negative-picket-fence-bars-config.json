{
  "version": "1.0.0",
  "title": {
    "text": "Pos/Neg Picket Fence Bars"
  },
  "plot": {
    "inverted": false
  },
  "animation": {
    "enabled": true,
    "expansionDuration": 300,
    "initialDuration": 3000,
    "valueChangeDuration": 3000,
    "contractionDuration": 300,
    "focusDuration": 500
  },
  "categoryAxis": {
    "valueLabel": "Category",
    "property": "categoryDO",
    "type": "date",
    "scale": "ordinal"
  },
  "valueAxisDefaults": {
    "base": 0,
    "softMin": 0,
    "softMax": 0,
    "tickLabel": {
      "format": "$.2f"
    }
  },
  "valueAxes": [
    {
      "id": "VA0",
      "side": "start"
    },
    {
      "id": "VA1",
      "side": "end"
    }
  ],
  "seriesDefaults": {
    "renderer": "bar",
    "marker": {
      "shape": null
    }
  },
  "series": [
    {
      "title": "Small Pos/Neg Dollars",
      "axis": "VA0",
      "property": "value7",
      "cap": {
        "size": 15,
        "type": "point"
      }
    },
    {
      "title": "Large Pos/Neg Dollars",
      "axis": "VA1",
      "property": "value9",
      "cap": {
        "size": 15,
        "type": "curve"
      }
    }
  ]
}
