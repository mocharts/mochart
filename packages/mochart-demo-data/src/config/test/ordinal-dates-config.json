{
  "version": "1.0.0",
  "title": {
    "text": "Ordinal Dates"
  },
  "animation": {
    "enabled": true,
    "expansionDuration": 300,
    "initialDuration": 300,
    "valueChangeDuration": 300,
    "contractionDuration": 300,
    "focusDuration": 500
  },
  "categoryAxis": {
    "property": "month_bought",
    "type": "date",
    "axisLine": {
      "visible": true,
      "marginInner": 0
    },
    "gridLine": {
      "visible": true
    },
    "scale": "ordinal",
    "tickLabel": {
      "format": "%B %Y",
      "truncation": {
        "enabled": false
      }
    },
    "valueFormat": "%B %Y",
    "valueLabel": "Category",
    "side": "end"
  },
  "valueAxes": [
    {
      "id": "VA0",
      "visible": true,
      "axisLine": {
        "marginInner": 0
      },
      "gridLine": {
        "visible": true
      },
      "tickLabel": {
        "format": "$.0f"
      },
      "min": 0,
      "side": "start"
    }
  ],
  "seriesStacks": [
    {
      "axis": "VA0",
      "id": "SS0"
    }
  ],
  "series": [
    {
      "axis": "VA0",
      "stack": "SS0",
      "property": "total",
      "renderer": "bar",
      "title": "Total"
    }
  ]
}
