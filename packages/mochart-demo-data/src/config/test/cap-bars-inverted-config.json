{
  "version": "1.0.0",
  "title": {
    "text": "Capped Inverted Bars"
  },
  "plot": {
    "inverted": true
  },
  "animation": {
    "enabled": true,
    "expansionDuration": 1500,
    "initialDuration": 8000,
    "valueChangeDuration": 8000,
    "contractionDuration": 1500,
    "focusDuration": 800
  },
  "categoryAxis": {
    "title": {
      "text": "Month"
    },
    "axisLine": {
      "visible": true,
      "marginInner": 0
    },
    "gridLine": {
      "visible": true
    },
    "tickLabel": {
      "format": "%b",
      "rotation": 45
    },
    "tickCount": 12,
    "type": "date",
    "scale": "ordinal",
    "dateUTC": true,
    "valueLabel": "Category",
    "valueFormat": "%B",
    "property": "date",
    "side": "end"
  },
  "valueAxes": {
    "visible": true,
    "axisLine": {
      "marginInner": 0
    },
    "gridLine": {
      "visible": true
    },
    "tickLabel": {
      "format": "$s"
    },
    "title": {
      "text": "Monthly Amount"
    },
    "min": -5000,
    "max": 5000,
    "side": "start"
  },
  "seriesStacks": {},
  "seriesDefaults": {
    "renderer": "bar",
    "marker": {
      "shape": null
    }
  },
  "series": [
    {
      "title": "Round",
      "property": "value1",
      "cap": {
        "size": 15,
        "type": "round",
        "expand": false
      },
      "shapeStyle": {
        "normal": {
          "strokeColor": "#1f77b4",
          "fillColor": "#1f77b4"
        }
      }
    },
    {
      "title": "Curve",
      "property": "value2",
      "cap": {
        "size": 15,
        "type": "curve",
        "expand": false
      },
      "shapeStyle": {
        "normal": {
          "strokeColor": "#ff7f0e",
          "fillColor": "#ff7f0e"
        }
      }
    },
    {
      "title": "Point",
      "property": "value3",
      "cap": {
        "size": 15,
        "type": "point",
        "expand": false
      },
      "shapeStyle": {
        "normal": {
          "strokeColor": "#2ca02c",
          "fillColor": "#2ca02c"
        }
      }
    },
    {
      "title": "Round Expand",
      "property": "value1",
      "cap": {
        "size": 15,
        "type": "round",
        "expand": true
      },
      "shapeStyle": {
        "normal": {
          "strokeColor": "#aec7e8",
          "fillColor": "#aec7e8"
        }
      }
    },
    {
      "title": "Curve Expand",
      "property": "value2",
      "cap": {
        "size": 15,
        "type": "curve",
        "expand": true
      },
      "shapeStyle": {
        "normal": {
          "strokeColor": "#ffbb78",
          "fillColor": "#ffbb78"
        }
      }
    },
    {
      "title": "Point Expand",
      "property": "value3",
      "cap": {
        "size": 15,
        "type": "point",
        "expand": true
      },
      "shapeStyle": {
        "normal": {
          "strokeColor": "#98df8a",
          "fillColor": "#98df8a"
        }
      }
    },
    {
      "title": "None",
      "property": "value4",
      "cap": {
        "size": 15,
        "type": null
      },
      "shapeStyle": {
        "normal": {
          "strokeColor": "#d62728",
          "fillColor": "#d62728"
        }
      }
    }
  ]
}
