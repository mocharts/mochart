{
  "version": "1.0.0",
  "title": {
    "text": "Monthly Data"
  },
  "animation": {
    "enabled": true,
    "expansionDuration": 300,
    "initialDuration": 300,
    "valueChangeDuration": 300,
    "contractionDuration": 300,
    "focusDuration": 500
  },
  "categoryAxis": {
    "title": {
      "text": "Month"
    },
    "axisLine": {
      "visible": true,
      "marginInner": 0
    },
    "gridLine": {
      "visible": true
    },
    "tickLabel": {
      "format": "%b",
      "rotation": 45
    },
    "tickCount": 12,
    "type": "date",
    "scale": "ordinal",
    "dateUTC": true,
    "valueLabel": "Category",
    "valueFormat": "%B",
    "property": "date",
    "side": "end"
  },
  "valueAxes": [
    {
      "visible": true,
      "axisLine": {
        "marginInner": 0
      },
      "gridLine": {
        "visible": true
      },
      "tickLabel": {
        "format": "$s"
      },
      "title": {
        "text": "Monthly Amount"
      },
      "min": 0,
      "id": "VA0",
      "side": "start"
    }
  ],
  "seriesStacks": [
    {
      "axis": "VA0",
      "id": "SS0"
    }
  ],
  "series": [
    {
      "renderer": "bar",
      "title": "Value 1",
      "marker": {
        "shape": null
      },
      "axis": "VA0",
      "stack": "SS0",
      "property": "value1"
    },
    {
      "renderer": "bar",
      "title": "Value 2",
      "marker": {
        "shape": null
      },
      "axis": "VA0",
      "stack": "SS0",
      "property": "value2"
    }
  ]
}
