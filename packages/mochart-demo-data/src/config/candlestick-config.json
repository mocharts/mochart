{
  "version": "1.0.0",
  "title": {
    "text": "Daily Share Price (fictional, $)"
  },
  "categoryAxis": {
    "property": "label",
    "type": "string",
    "scale": "ordinal"
  },
  "valueAxes": [
    {
      "id": "price",
      "minMarginFraction": 0.35,
      "maxMarginFraction": 0.05,
      "title": {
        "text": "$ per share"
      }
    },
    {
      "id": "volume",
      "min": 0,
      "maxMarginFraction": 4,
      "visible": false
    }
  ],
  "series": [
    {
      "id": "upWick",
      "property": "upHigh",
      "rangeProperty": "low",
      "axis": "price",
      "renderer": "bar",
      "bar": {
        "widthFraction": 0.15
      },
      "missingValueMode": "connect",
      "partialRangeIsMissing": true,
      "group": null,
      "stack": null,
      "showInLegend": false,
      "followSeries": "up",
      "valueLabel": "Range",
      "shapeStyle": {
        "normal": {
          "strokeColor": "#1baf7a",
          "fillColor": "#1baf7a",
          "fillOpacity": 1
        }
      },
      "valueFormat": ",.2f"
    },
    {
      "id": "downWick",
