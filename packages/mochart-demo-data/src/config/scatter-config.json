{
  "version": "1.0.0",
  "title": {
    "text": "Scatter Chart Example"
  },
  "categoryAxis": {
    "valueLabel": "Category",
    "property": "category",
    "type": "number",
    "scale": "linear"
  },
  "seriesDefaults": {
    "renderer": "none",
    "marker": {
      "size": 6
    }
  },
  "series": [
    {
      "property": "value1",
      "title": "Scatter 1",
      "shapeStyle": {
        "normal": {
          "strokeColor": "#9467bd",
          "fillColor": "#9467bd"
        }
      },
      "marker": {
        "shape": "star"
      }
    },
    {
      "axis": "VA0",
      "property": "value2",
      "title": "Scatter 2",
      "shapeStyle": {
        "normal": {
          "strokeColor": "#ffbb78",
          "fillColor": "#ffbb78"
        }
      },
      "marker": {
        "shape": "cross"
      }
    },
    {
      "axis": "VA0",
      "property": "value3",
      "title": "Scatter 3",
      "shapeStyle": {
        "normal": {
          "strokeColor": "#1f77b4",
          "fillColor": "#1f77b4"
        }
      },
      "marker": {
        "shape": "wye"
      }
    }
  ]
}
