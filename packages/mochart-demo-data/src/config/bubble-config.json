{
  "version": "1.0.0",
  "title": {
    "text": "Bubble Chart Example"
  },
  "animation": {
    "expansionDuration": 1000,
    "initialDuration": 1000,
    "valueChangeDuration": 1000,
    "contractionDuration": 1000
  },
  "categoryAxis": {
    "valueLabel": "Category",
    "property": "category",
    "type": "number",
    "scale": "ordinal",
    "categoryCountPadding": 1
  },
  "valueAxes": {},
  "seriesDefaults": {
    "renderer": "none",
    "marker": {
      "minSize": 3,
      "size": 24
    }
  },
  "series": [
    {
      "property": "value1",
      "title": "Bubble 1",
      "shapeStyle": {
        "normal": {
          "strokeColor": "#9467bd",
          "fillColor": "#9467bd"
        }
      },
      "markerProperty": "marker1",
      "marker": {
        "shape": "circle"
      }
    },
    {
      "property": "value2",
      "title": "Bubble 2",
      "shapeStyle": {
        "normal": {
          "strokeColor": "#ffbb78",
          "fillColor": "#ffbb78"
        }
      },
      "markerProperty": "marker2",
      "marker": {
        "shape": "cross"
      }
    }
  ]
}
