{
  "version": "1.0.0",
  "title": {
    "text": "Gradients"
  },
  "animation": {
    "enabled": true,
    "expansionDuration": 500,
    "initialDuration": 500,
    "valueChangeDuration": 500,
    "contractionDuration": 500,
    "focusDuration": 700
  },
  "categoryAxis": {
    "axisLine": {
      "visible": true,
      "marginInner": 0
    },
    "type": "number",
    "scale": "ordinal",
    "valueLabel": "Category",
    "property": "categoryNO",
    "side": "end"
  },
  "valueAxes": {
    "axisLine": {
      "marginInner": 0
    },
    "gridLine": {
      "visible": true
    },
    "min": 0,
    "side": "start"
  },
  "linearGradientDefaults": {
    "x1": 0,
    "y1": 0,
    "x2": 0,
    "y2": 1
  },
  "linearGradients": [
    {
      "id": "LG0",
      "stops": [
        {
          "offset": 0.1,
          "color": "#ff0000",
          "opacity": 0.8
        },
        {
          "offset": 0.9,
          "color": "#0000ff",
          "opacity": 0.8
        }
      ]
    },
    {
      "id": "LG1",
      "rotation": 45,
      "stops": [
        {
          "offset": 0,
          "color": "#0000ff",
          "opacity": 0.8
        },
        {
          "offset": 1,
          "color": "#00ff00",
          "opacity": 0.8
        }
      ]
    }
  ],
  "radialGradientDefaults": {
    "cx": 0.5,
    "cy": 0.5,
    "r": 0.5
  },
  "radialGradients": [
    {
      "id": "RG0",
      "fx": 0.5,
      "fy": 0.5,
      "stops": [
        {
          "offset": 0.1,
          "color": "#ff0000",
          "opacity": 0.8
        },
        {
          "offset": 0.9,
          "color": "#0000ff",
          "opacity": 0.8
        }
      ]
    },
    {
      "id": "RG1",
      "fx": 0.75,
      "fy": 0.75,
      "stops": [
        {
          "offset": 0,
          "color": "#0000ff",
          "opacity": 0.8
        },
        {
          "offset": 1,
          "color": "#00ff00",
          "opacity": 0.8
        }
      ]
    }
  ],
  "seriesDefaults": {
    "marker": {
      "shape": null
    }
  },
  "series": [
    {
      "renderer": "area",
      "title": "Linear Gradient",
      "property": "value0",
      "gradient": "LG0"
    },
    {
      "renderer": "bar",
      "title": "Linear Rotated Gradient",
      "property": "value1",
      "gradient": "LG1"
    },
    {
      "renderer": "area",
      "title": "Radial Gradient",
      "property": "value2",
      "gradient": "RG0"
    },
    {
      "renderer": "bar",
      "title": "Radial Offset Gradient",
      "property": "value3",
      "gradient": "RG1"
    }
  ]
