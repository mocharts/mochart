{
  "version": "1.0.0",
  "title": {
    "text": "Curved Lines"
  },
  "animation": {
    "enabled": true,
    "expansionDuration": 500,
    "initialDuration": 500,
    "valueChangeDuration": 500,
    "contractionDuration": 500,
    "focusDuration": 700
  },
  "categoryAxis": {
    "title": {
      "text": "Time (in Minutes)"
    },
    "axisLine": {
      "visible": true,
      "marginInner": 0
    },
    "tickLabel": {
      "format": "%_H:%M"
    },
    "type": "date",
    "scale": "linear",
    "dateUTC": true,
    "valueLabel": "Time",
    "property": "time",
    "side": "end"
  },
  "valueAxes": {
    "axisLine": {
      "marginInner": 0
    },
    "gridLine": {
      "visible": true
    },
    "tickLabel": {
      "format": "$s"
    },
    "title": {
      "text": "Sales Value"
    },
    "min": 0,
    "side": "start"
  },
  "seriesDefaults": {
    "marker": {
      "shape": null
    }
  },
  "series": [
    {
      "renderer": "area",
      "title": "Sales A Natural",
      "property": "sales_a",
      "curve": {
        "type": "natural"
      }
    },
    {
      "renderer": "line",
      "title": "Sales A Linear",
      "property": "sales_a"
    },
    {
      "renderer": "area",
      "title": "Sales B Stepped",
      "property": "sales_b",
      "curve": {
        "type": "step"
      }
    },
    {
      "renderer": "line",
      "title": "Sales B Linear",
      "property": "sales_b"
    }
  ]
}
