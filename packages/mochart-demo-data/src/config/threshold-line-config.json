{
  "version": "1.0.0",
  "title": {
    "text": "Threshold Line"
  },
  "animation": {
    "expansionDuration": 2000,
    "initialDuration": 2000,
    "valueChangeDuration": 2000,
    "contractionDuration": 2000
  },
  "plot": {
    "inverted": false
  },
  "categoryAxis": {
    "valueLabel": "Category",
    "property": "categoryNO",
    "type": "number",
    "scale": "ordinal"
  },
  "valueAxes": [
    {
      "id": "VA0",
      "adjustForFiltering": true,
      "side": "start",
      "thresholds": [
        {
          "value": 20,
          "title": {
            "text": "Title For Threshold 20",
            "side": "low",
            "snapToValue": true,
            "padding": {
              "top": 5,
              "right": 5,
              "bottom": 5,
              "left": 5
            }
          }
        }
      ]
    },
    {
      "id": "VA1",
      "adjustForFiltering": false,
      "side": "end",
      "thresholds": [
        {
          "value": -5,
          "title": {
            "text": "Title For Threshold -5",
            "side": "high",
            "snapToValue": true,
            "padding": {
              "top": 5,
              "right": 5,
              "bottom": 5,
              "left": 5
            }
          }
        }
      ]
    }
  ],
  "seriesStacks": {
    "axis": "VA0"
  },
  "series": [
    {
      "axis": "VA0",
      "property": "value1",
      "title": "Stacked Bar 1",
      "renderer": "bar"
    },
    {
      "axis": "VA0",
      "property": "value2",
      "title": "Stacked Bar 2",
      "renderer": "bar"
    },
    {
      "axis": "VA0",
      "property": "value3",
      "title": "Stacked Bar 3",
      "renderer": "bar"
    },
    {
      "axis": "VA1",
      "stack": null,
      "property": "value5",
      "title": "Line 1",
      "renderer": "line"
    },
    {
      "axis": "VA1",
      "stack": null,
      "property": "value6",
      "title": "Line 2",
      "renderer": "line"
    }
  ]
}
