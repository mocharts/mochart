{
  "version": "1.0.0",
  "title": {
    "text": "Threshold Range"
  },
  "animation": {
    "expansionDuration": 2000,
    "initialDuration": 2000,
    "valueChangeDuration": 2000,
    "contractionDuration": 2000
  },
  "plot": {
    "inverted": false
  },
  "categoryAxis": {
    "valueLabel": "Category",
    "property": "categoryNO",
    "type": "number",
    "scale": "ordinal"
  },
  "valueAxes": [
    {
      "id": "VA0",
      "adjustForFiltering": true,
      "side": "start",
      "softMax": 38,
      "thresholds": [
        {
          "value": 0,
          "rangeValue": 5,
          "title": {
            "text": "Floor"
          }
        },
        {
          "value": 10,
          "rangeValue": 25,
          "style": {
            "normal": {
              "fillColor": "#1baf7a",
              "fillOpacity": 0.15,
              "strokeColor": "#1baf7a",
              "strokeOpacity": 0.8
            }
          },
          "title": {
            "text": "Target",
            "side": "inside",
            "align": "middle",
            "padding": {
              "top": 4,
              "right": 6,
              "bottom": 4,
              "left": 6
            }
          }
        },
        {
          "value": 28,
          "rangeValue": 32,
          "pattern": "hatch",
          "style": {
            "normal": {
              "fillColor": "#e34948",
              "strokeColor": "#e34948",
              "strokeOpacity": 0.8
            }
          },
          "title": {
            "text": "Stretch",
            "side": "high",
            "align": "end",
            "padding": {
              "top": 5,
              "right": 5,
              "bottom": 5,
              "left": 5
            }
          }
        }
      ]
    }
  ],
  "seriesStacks": {
    "axis": "VA0"
  },
  "seriesDefaults": {
    "pattern": null
  },
  "series": [
    {
      "axis": "VA0",
      "property": "value1",
      "title": "Stacked Bar 1",
      "renderer": "bar"
    },
    {
      "axis": "VA0",
      "property": "value2",
      "title": "Stacked Bar 2",
      "renderer": "bar"
    },
    {
      "axis": "VA0",
      "property": "value3",
      "title": "Stacked Bar 3",
      "renderer": "bar"
    }
  ],
  "patterns": [
    {
      "id": "hatch",
      "type": "lines",
      "foregroundOpacity": 0.5
    }
  ]
}
