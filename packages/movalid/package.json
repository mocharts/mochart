{
  "name": "@mochart/movalid",
  "version": "1.0.0",
  "description": "Simple yet powerful TypeScript validators",
  "keywords": [
    "validation",
    "chainable",
    "type checking"
  ],
  "license": "MIT",
  "author": {
    "name": "Jon Harris",
    "url": "https://github.com/jharris4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mocharts/mochart.git",
    "directory": "packages/movalid"
  },
  "homepage": "https://mochart.org",
  "bugs": {
    "url": "https://github.com/mocharts/mochart/issues"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/validators.d.ts",
        "default": "./dist/validators.js"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/validators.js",
  "module": "./dist/validators.js",
  "types": "./dist/validators.d.ts",
  "exports": {
    ".": {
      "development": "./src/validators.ts",
      "types": "./dist/validators.d.ts",
      "default": "./dist/validators.js"
    }
  },
  "files": [
    "src",
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  }
}
