{
  "name": "@mochart/vue",
  "version": "1.0.0",
  "description": "Vue 3 components for the mochart charting library",
  "keywords": [
    "chart",
    "vue",
    "animation",
    "responsive",
    "svg",
    "mochart"
  ],
  "license": "MIT",
  "author": {
    "name": "Jon Harris",
    "url": "https://github.com/jharris4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mocharts/mochart.git",
    "directory": "packages/mochart-vue"
  },
  "homepage": "https://mochart.org",
  "bugs": {
    "url": "https://github.com/mocharts/mochart/issues"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@mochart/core": "^1.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@mochart/core": "^1.0.0",
    "vue": "^3.5.41"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  }
}
