{
  "name": "@mochart/svelte",
  "version": "1.0.0",
  "description": "Svelte 5 components for the mochart charting library",
  "keywords": [
    "chart",
    "svelte",
    "animation",
    "responsive",
    "svg",
    "mochart"
  ],
  "license": "MIT",
  "author": {
    "name": "Jon Harris",
    "url": "https://github.com/jharris4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mocharts/mochart.git",
    "directory": "packages/mochart-svelte"
  },
  "homepage": "https://mochart.org",
  "bugs": {
    "url": "https://github.com/mocharts/mochart/issues"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@mochart/core": "^1.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@mochart/core": "^1.0.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist --tsconfig ./tsconfig.build.json && node scripts/prune-component-maps.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint ."
  }
}
