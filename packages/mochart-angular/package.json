{
  "name": "@mochart/angular",
  "version": "1.0.0",
  "description": "Angular components for the mochart charting library",
  "keywords": [
    "chart",
    "angular",
    "animation",
    "responsive",
    "svg",
    "mochart"
  ],
  "license": "MIT",
  "author": {
    "name": "Jon Harris",
    "url": "https://github.com/jharris4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mocharts/mochart.git",
    "directory": "packages/mochart-angular"
  },
  "homepage": "https://mochart.org",
  "bugs": {
    "url": "https://github.com/mocharts/mochart/issues"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@angular/core": ">=22.0.0",
    "@mochart/core": "^1.0.0"
  },
  "devDependencies": {
    "@angular/compiler": "^22.1.1",
    "@mochart/core": "^1.0.0",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "rxjs": "^7.8.2"
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  }
}
