{
  "name": "mochart-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for the mochart charting library, the movalid validation library, and the mochart demo app",
  "private": true,
  "license": "BSD-3-Clause",
  "author": {
    "name": "Jon Harris",
    "url": "https://github.com/jharris4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jharris4/mochart.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "scripts": {
    "dev": "npm run dev -w @mochart/demo-vanilla",
    "dev:basic": "npm run dev -w @mochart/demo-basic",
    "dev:showcase": "npm run dev -w @mochart/showcase",
    "dev:docs": "npm run dev -w @mochart/docs",
    "dev:editor": "npm run dev -w @mochart/editor",
    "build": "npm run build -w @mochart/demo-vanilla",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "PAGES_BASE=/ node scripts/build-pages.mjs && PAGES_BASE=/ node scripts/preview-pages.mjs",
    "preview:pages:serve": "PAGES_BASE=/ node scripts/preview-pages.mjs",
    "build:libs": "npm run build -w @mochart/movalid && npm run build -w @mochart/core && npm run build -w @mochart/editor && npm run build -w @mochart/export && npm run build -w @mochart/react && npm run build -w @mochart/svelte && npm run build -w @mochart/vue && npm run build -w @mochart/lit && npm run build -w @mochart/angular",
    "prepare": "npm run build:libs",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @mochart/demo-basic",
    "screenshots": "node scripts/screenshots/capture.mjs",
    "screenshots:compare": "node scripts/screenshots/compare.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deadcode": "knip --include exports,types,files",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.22.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "jsdom": "^29.1.1",
    "knip": "6.29.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "10.4.1"
  }
}
